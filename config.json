{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/refs/tags/pi-permission-system-v41.0.0/packages/pi-permission-system/schemas/permissions.schema.json",
  "yoloMode": false,
  "debugLog": false,
  "permissionReviewLog": true,
  "doublePressToConfirm": true,
  "promptMaxRows": 32,
  "promptFieldMaxWidth": 1200,
  "promptNotifications": [
    "bell"
  ],
  "authorizerChain": [],
  "permission": {
    "*": "ask",
    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "write": "allow",
    "edit": "allow",
    "powershell": "ask",
    "path_read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "*/.env": "deny",
      "*/.env.*": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.crt": "deny",
      "*.cer": "deny",
      "*.der": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.p7b": "deny",
      "*.p7c": "deny",
      "*.jks": "deny",
      "*.keystore": "deny",
      "id_rsa*": "deny",
      "*/id_rsa*": "deny",
      "id_ed25519*": "deny",
      "*/id_ed25519*": "deny",
      "id_ecdsa*": "deny",
      "*/id_ecdsa*": "deny",
      "id_dsa*": "deny",
      "*/id_dsa*": "deny",
      ".ssh": "deny",
      "*/.ssh": "deny",
      "*/.ssh/*": "deny",
      ".aws": "deny",
      "*/.aws": "deny",
      "*/.aws/*": "deny",
      ".azure": "deny",
      "*/.azure": "deny",
      "*/.azure/*": "deny",
      ".gnupg": "deny",
      "*/.gnupg": "deny",
      "*/.gnupg/*": "deny",
      ".kube": "deny",
      "*/.kube": "deny",
      "*/.kube/*": "deny",
      ".npmrc": "deny",
      "*/.npmrc": "deny",
      ".netrc": "deny",
      "*/.netrc": "deny",
      "_netrc": "deny",
      "*/_netrc": "deny",
      ".pypirc": "deny",
      "*/.pypirc": "deny",
      ".git-credentials": "deny",
      "*/.git-credentials": "deny",
      "*/.docker/config.json": "deny",
      "*/.config/gh/hosts.yml": "deny",
      "*/GitHub CLI/hosts.yml": "deny",
      "credentials.json": "deny",
      "*/credentials.json": "deny",
      "service-account*.json": "deny",
      "*/service-account*.json": "deny",
      "~/.pi/agent/auth.json": "deny",
      "~/.pi/agent/mcp-auth.json": "deny",
      "~/.codex/auth.json": "deny"
    },
    "path_write": {
      "*": "ask",
      "/dev/null": "allow",
      "/dev/stdout": "allow",
      "/dev/stderr": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "*/.env": "deny",
      "*/.env.*": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*.crt": "deny",
      "*.cer": "deny",
      "*.der": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.p7b": "deny",
      "*.p7c": "deny",
      "*.jks": "deny",
      "*.keystore": "deny",
      "id_rsa*": "deny",
      "*/id_rsa*": "deny",
      "id_ed25519*": "deny",
      "*/id_ed25519*": "deny",
      "id_ecdsa*": "deny",
      "*/id_ecdsa*": "deny",
      "id_dsa*": "deny",
      "*/id_dsa*": "deny",
      ".ssh": "deny",
      "*/.ssh": "deny",
      "*/.ssh/*": "deny",
      ".aws": "deny",
      "*/.aws": "deny",
      "*/.aws/*": "deny",
      ".azure": "deny",
      "*/.azure": "deny",
      "*/.azure/*": "deny",
      ".gnupg": "deny",
      "*/.gnupg": "deny",
      "*/.gnupg/*": "deny",
      ".kube": "deny",
      "*/.kube": "deny",
      "*/.kube/*": "deny",
      ".npmrc": "deny",
      "*/.npmrc": "deny",
      ".netrc": "deny",
      "*/.netrc": "deny",
      "_netrc": "deny",
      "*/_netrc": "deny",
      ".pypirc": "deny",
      "*/.pypirc": "deny",
      ".git-credentials": "deny",
      "*/.git-credentials": "deny",
      "*/.docker/config.json": "deny",
      "*/.config/gh/hosts.yml": "deny",
      "*/GitHub CLI/hosts.yml": "deny",
      "credentials.json": "deny",
      "*/credentials.json": "deny",
      "service-account*.json": "deny",
      "*/service-account*.json": "deny",
      "~/.pi/agent/auth.json": "deny",
      "~/.pi/agent/mcp-auth.json": "deny",
      "~/.codex/auth.json": "deny"
    },
    "external_directory_read": {
      "*": "ask"
    },
    "external_directory_write": {
      "*": "ask"
    },
    "bash": {
      "*": "ask",
      "echo": "allow",
      "echo *": "allow",
      "cd *": "allow",
      "sed *": "allow",
      "pwd": "allow",
      "ls": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc": "allow",
      "wc *": "allow",
      "stat *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "egrep *": "allow",
      "fgrep *": "allow",
      "diff *": "allow",
      "cmp *": "allow",
      "comm *": "allow",
      "sort": "allow",
      "sort *": "allow",
      "uniq": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "basename *": "allow",
      "dirname *": "allow",
      "realpath *": "allow",
      "which *": "allow",
      "tree": "allow",
      "tree *": "allow",
      "du": "allow",
      "du *": "allow",
      "df": "allow",
      "df *": "allow",
      "find *": "allow",
      "fd *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git blame *": "allow",
      "git ls-files": "allow",
      "git ls-files *": "allow",
      "git branch --show-current": "allow",
      "git remote -v": "allow",
      "git rev-parse --show-toplevel": "allow",
      "*--output*": "ask",
      "* -o*": "ask",
      "*--ext-diff*": "ask",
      "*--textconv*": "ask",
      "*--pre*": "ask",
      "*--hostname-bin*": "ask",
      "*--files0-from*": "ask"
    },
    "mcp": "ask",
    "skill": "ask"
  },
  "commandEffects": {
    "git": {
      "unlessOption": [
        "--output"
      ],
      "subcommands": {
        "status": "read",
        "diff": "read",
        "log": "read",
        "show": "read",
        "blame": "read",
        "ls-files": "read",
        "rev-parse": "read"
      }
    },
    "cmp": {
      "effects": "read"
    },
    "comm": {
      "effects": "read"
    },
    "cut": {
      "effects": "read"
    },
    "tr": {
      "effects": "read"
    },
    "tree": {
      "effects": "read",
      "unlessOption": [
        "-o",
        "--output"
      ]
    },
    "du": {
      "effects": "read"
    },
    "df": {
      "effects": "read"
    }
  }
}
